# Copy to .env and fill in. This repo contains no credentials, no private data,
# and no connection strings. Agency data is downloaded by `wrangle fetch`.

# Which AI suggests field and value matches. Everything else works without either.
#   ollama     an open model on your own machine (https://ollama.com): no key, no cost
#   anthropic  Claude, through Anthropic's API: needs ANTHROPIC_API_KEY and the `ai` extra
WRANGLE_AI=ollama
# The Ollama model to ask, after `ollama pull <model>`.
WRANGLE_AI_MODEL=qwen3:14b
# Where Ollama listens, if not on this machine.
# OLLAMA_HOST=http://localhost:11434

# Only for WRANGLE_AI=anthropic. Each source costs one call; answers are recorded
# under cache/ai/ and replayed after that.
ANTHROPIC_API_KEY=

# Cache behaviour: replay | prefer | live | refresh
# `replay` is what runs on stage — a cache miss is a loud error, not a silent
# network call.
WRANGLE_CACHE_MODE=prefer

# Where recorded responses live. Defaults to cache/ in this folder.
# WRANGLE_CACHE_DIR=

# Where things live, if not next to the app. A variable already set in the shell wins
# over this file.
# WRANGLE_DATA_DIR=          downloaded layers (default data/)
# WRANGLE_OUT_DIR=           converted GeoParquet (default out/)
# WRANGLE_DB=                the decisions database (default wrangle.db)
# WRANGLE_MAPPINGS_DIR=      a folder to keep wrangle.db in instead (WRANGLE_DB wins)
